---
// Accessibility menu (elev8.io standard, no third-party script): a 45px round button bottom-left opens a small panel
// with text size, high contrast, underlined links, readable font, pause animations and reset. Choices are kept per
// visitor in localStorage and re-applied (classes on <html>, zoom on <body>) as soon as the page script runs.
// Keyboard: the button toggles, Esc closes and returns focus, focus stays logical inside the panel.
const toggles = [
  { key: 'contrast', label: 'High contrast', icon: 'M12 3a9 9 0 1 0 0 18V3z' },
  { key: 'links', label: 'Underline links', icon: 'M6 4v7a6 6 0 0 0 12 0V4M5 21h14' },
  { key: 'font', label: 'Readable font', icon: 'M4 20 10 4h4l6 16M7 14h10' },
  { key: 'motion', label: 'Pause animations', icon: 'M9 5v14M15 5v14' },
];
---
<div class="a11y" data-a11y>
  <button type="button" class="a11y-btn" aria-expanded="false" aria-controls="a11y-panel" aria-label="Accessibility options" data-a11y-open>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="4.5" r="2" fill="currentColor" /><path d="M5 8.5c2.3.7 4.6 1 7 1s4.7-.3 7-1M12 9.5v4.5m0 0-3 6.5m3-6.5 3 6.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <div class="a11y-panel" id="a11y-panel" role="dialog" aria-label="Accessibility options" hidden>
    <div class="a11y-head">
      <p>Accessibility</p>
      <button type="button" class="a11y-x" aria-label="Close accessibility options" data-a11y-close>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
      </button>
    </div>
    <div class="a11y-size" role="group" aria-label="Text size">
      <button type="button" data-a11y-size="-1" aria-label="Smaller text">A−</button>
      <output data-a11y-size-value aria-live="polite">100%</output>
      <button type="button" data-a11y-size="1" aria-label="Larger text">A+</button>
    </div>
    <ul class="a11y-list">
      {toggles.map((t) => (
        <li>
          <button type="button" class="a11y-opt" aria-pressed="false" data-a11y-toggle={t.key}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={t.icon} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span>{t.label}</span>
            <span class="a11y-sw" aria-hidden="true"></span>
          </button>
        </li>
      ))}
    </ul>
    <button type="button" class="a11y-reset" data-a11y-reset>Reset all</button>
  </div>
</div>

<style is:global>
  /* Effects of each option, on <html> so they also reach the header, footer and cookie banner */
  html.a11y-contrast main, html.a11y-contrast .site-header, html.a11y-contrast .site-footer { filter: contrast(1.35) saturate(1.1); }
  html.a11y-links main a, html.a11y-links .site-footer a { text-decoration: underline !important; text-underline-offset: 3px; }
  html.a11y-font body, html.a11y-font h1, html.a11y-font h2, html.a11y-font h3, html.a11y-font .btn { font-family: Verdana, Tahoma, Arial, sans-serif !important; letter-spacing: .02em !important; word-spacing: .08em; }
  html.a11y-motion *, html.a11y-motion *::before, html.a11y-motion *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
</style>

<style>
  .a11y { position: fixed; left: 16px; bottom: 16px; z-index: 60; font-family: var(--font); }
  .a11y-btn { display: grid; place-items: center; width: 45px; height: 45px; padding: 0; border: 2px solid #fff; border-radius: 999px; background: var(--forest); color: #fff; cursor: pointer;
    box-shadow: 0 6px 18px rgb(13 53 102 / .35); transition: transform .2s, background .2s; }
  .a11y-btn:hover { background: var(--forest-deep); transform: scale(1.06); }
  .a11y-btn svg { width: 24px; height: 24px; }
  .a11y-panel { position: absolute; left: 0; bottom: 57px; width: 260px; padding: 14px; background: #fff; color: var(--ink); border-radius: 22px; box-shadow: 0 24px 60px rgb(15 23 42 / .28); border-top: 4px solid var(--olive); }
  .a11y-head { display: flex; align-items: center; justify-content: space-between; }
  .a11y-head p { font-family: var(--display); font-weight: 700; font-size: 17px; color: var(--forest-deep); }
  .a11y-x { display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 10px; background: var(--sage-soft); color: var(--forest); cursor: pointer; }
  .a11y-x svg { width: 16px; height: 16px; }
  .a11y-size { display: grid; grid-template-columns: 45px 1fr 45px; align-items: center; margin-top: 12px; border-radius: 12px; background: var(--sage-soft); overflow: hidden; }
  .a11y-size button { height: 45px; border: 0; background: none; color: var(--forest-deep); font-weight: 800; font-size: 16px; cursor: pointer; }
  .a11y-size button:hover { background: var(--sage); }
  .a11y-size output { text-align: center; font-weight: 700; font-size: 14px; color: var(--forest-deep); }
  .a11y-list { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 6px; }
  .a11y-opt { display: flex; align-items: center; gap: 10px; width: 100%; height: 45px; padding: 0 12px; border: 1px solid #c3cad4; border-radius: 12px; background: #fff; color: var(--forest-deep); font: 600 14.5px var(--font); text-align: left; cursor: pointer; }
  .a11y-opt:hover { border-color: var(--forest); }
  .a11y-opt svg { width: 18px; height: 18px; flex: none; }
  .a11y-opt span:nth-child(2) { flex: 1; }
  /* Small on/off switch, so the state reads without colour alone */
  .a11y-sw { position: relative; width: 32px; height: 18px; flex: none; border-radius: 99px; background: #6b7280; transition: background .2s; }
  .a11y-sw::after { content: ''; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 99px; background: #fff; transition: transform .2s; }
  .a11y-opt[aria-pressed='true'] { border-color: var(--forest); background: var(--sage-soft); }
  .a11y-opt[aria-pressed='true'] .a11y-sw { background: var(--forest); }
  .a11y-opt[aria-pressed='true'] .a11y-sw::after { transform: translateX(14px); }
  .a11y-reset { width: 100%; height: 45px; margin-top: 8px; border: 0; border-radius: 12px; background: none; color: var(--forest); font: 700 14px var(--font); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  /* Forest ring with a white halo: at least 3:1 on the white panel and on any page background behind the button */
  .a11y :focus-visible { outline: 3px solid var(--forest-deep); outline-offset: 2px; box-shadow: 0 0 0 5px #fff; }
</style>

<script>
  const KEY = 'elevatepoint_a11y';
  const SIZES = [90, 100, 112, 125, 140];
  type State = { size: number; contrast?: boolean; links?: boolean; font?: boolean; motion?: boolean };
  const root = document.querySelector<HTMLElement>('[data-a11y]')!;
  const openBtn = root.querySelector<HTMLButtonElement>('[data-a11y-open]')!;
  const panel = root.querySelector<HTMLElement>('#a11y-panel')!;
  const sizeOut = root.querySelector<HTMLOutputElement>('[data-a11y-size-value]')!;
  let state: State = { size: 100 };
  try { state = { size: 100, ...JSON.parse(localStorage.getItem(KEY) || '{}') }; } catch {}

  const apply = () => {
    const html = document.documentElement;
    (['contrast', 'links', 'font', 'motion'] as const).forEach((k) => html.classList.toggle(`a11y-${k}`, !!state[k]));
    // zoom scales the px-based type and layout together; 100% removes it
    document.body.style.zoom = state.size === 100 ? '' : String(state.size / 100);
    sizeOut.value = `${state.size}%`;
    root.querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(!!state[b.dataset.a11yToggle as keyof State])));
    try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {}
  };
  const setOpen = (open: boolean) => {
    panel.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    if (open) panel.querySelector<HTMLButtonElement>('[data-a11y-size="1"]')?.focus();
    else openBtn.focus();
  };

  openBtn.addEventListener('click', () => setOpen(panel.hidden));
  root.querySelector('[data-a11y-close]')!.addEventListener('click', () => setOpen(false));
  root.querySelectorAll<HTMLButtonElement>('[data-a11y-size]').forEach((b) => b.addEventListener('click', () => {
    const i = SIZES.indexOf(state.size) + Number(b.dataset.a11ySize);
    state.size = SIZES[Math.min(SIZES.length - 1, Math.max(0, i))];
    apply();
  }));
  root.querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]').forEach((b) => b.addEventListener('click', () => {
    const k = b.dataset.a11yToggle as 'contrast' | 'links' | 'font' | 'motion';
    state[k] = !state[k];
    apply();
  }));
  root.querySelector('[data-a11y-reset]')!.addEventListener('click', () => { state = { size: 100 }; apply(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) setOpen(false); });
  document.addEventListener('click', (e) => { if (!panel.hidden && !root.contains(e.target as Node)) { panel.hidden = true; openBtn.setAttribute('aria-expanded', 'false'); } });
  apply();
</script>

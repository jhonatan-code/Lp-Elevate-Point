---
// Inline icons (stroke = currentColor, decorative).
interface Props { name: string; class?: string }
const { name, class: cls } = Astro.props;
const line = { viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width': 2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'aria-hidden': 'true' } as const;
---
{name === 'phone' && <svg class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.6a1 1 0 0 1-.25 1z" /></svg>}
{name === 'star' && <svg class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" /></svg>}
{name === 'check' && <svg class={cls} {...line} stroke-width="2.6"><path d="M4 12.5l5 5L20 6.5" /></svg>}
{name === 'plus' && <svg class={cls} {...line}><path d="M12 5v14M5 12h14" /></svg>}
{name === 'arrow' && <svg class={cls} {...line}><path d="M5 12h14M13 6l6 6-6 6" /></svg>}
{name === 'pin' && <svg class={cls} {...line}><path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>}
{name === 'shield' && <svg class={cls} {...line}><path d="M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6z" /><path d="M8.5 12l2.5 2.5 4.5-5" /></svg>}
{name === 'home' && <svg class={cls} {...line}><path d="M3 10.5 12 3l9 7.5" /><path d="M5 9.5V21h14V9.5" /><path d="M10 21v-6h4v6" /></svg>}
{name === 'users' && <svg class={cls} {...line}><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c.6-3.4 3.3-5.5 6.5-5.5s5.9 2.1 6.5 5.5" /><circle cx="17.5" cy="9" r="2.5" /><path d="M17 14.6c2.3.3 4 1.9 4.5 4.4" /></svg>}
{name === 'meal' && <svg class={cls} {...line}><path d="M4 3v7a3 3 0 0 0 6 0V3M7 3v18" /><path d="M17 21V3c-2.2 1.2-3.5 3.8-3.5 7.5V13H17" /></svg>}
{name === 'ball' && <svg class={cls} {...line}><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3v18M5.6 5.6c3.2 3.2 3.2 9.6 0 12.8M18.4 5.6c-3.2 3.2-3.2 9.6 0 12.8" /></svg>}
{name === 'palette' && <svg class={cls} {...line}><circle cx="13.5" cy="6.5" r="1.5" /><circle cx="17.5" cy="10.5" r="1.5" /><circle cx="8.5" cy="7.5" r="1.5" /><circle cx="6.5" cy="12.5" r="1.5" /><path d="M12 2a10 10 0 1 0 0 20c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.4-.3-.4-.5-.8-.5-1.3 0-1.1.9-2 2-2h2.3A4.7 4.7 0 0 0 22 10.6C22 5.8 17.5 2 12 2z" /></svg>}
{name === 'brain' && <svg class={cls} {...line}><path d="M9.5 3A3 3 0 0 0 6.6 5.3 3 3 0 0 0 4 8.5a3 3 0 0 0 .6 1.8A3.5 3.5 0 0 0 5 16.5 3.5 3.5 0 0 0 9.5 20h.5V3z" /><path d="M14.5 3a3 3 0 0 1 2.9 2.3A3 3 0 0 1 20 8.5a3 3 0 0 1-.6 1.8 3.5 3.5 0 0 1-.4 6.2 3.5 3.5 0 0 1-4.5 3.5H14V3z" /></svg>}
{name === 'pill' && <svg class={cls} {...line}><rect x="3" y="8.5" width="18" height="7" rx="3.5" transform="rotate(-45 12 12)" /><path d="M9.5 9.5l5 5" /></svg>}
{name === 'apple' && <svg class={cls} {...line}><path d="M12 7c-1.5-1-5-1.2-6.6 1.6C3.6 11.8 5.5 18 8.3 20c1.3.9 2.4.4 3.7.4s2.4.5 3.7-.4c2.8-2 4.7-8.2 2.9-11.4C17 5.8 13.5 6 12 7z" /><path d="M12 7c0-2 1-3.5 3-4" /></svg>}
{name === 'mask' && <svg class={cls} {...line}><circle cx="12" cy="12" r="9" /><path d="M8.5 10h.01M15.5 10h.01" /><path d="M8.5 15.5c2-1.4 5-1.4 7 0" /></svg>}
{name === 'puzzle' && <svg class={cls} {...line}><path d="M10 4a2 2 0 1 1 4 0v1h4v4h1a2 2 0 1 1 0 4h-1v5h-5v-1a2 2 0 1 0-4 0v1H4v-5h1a2 2 0 1 0 0-4H4V5h6z" /></svg>}
{name === 'moon' && <svg class={cls} {...line}><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" /></svg>}
{name === 'glass' && <svg class={cls} {...line}><path d="M7 3h10l-.6 6.2A4.4 4.4 0 0 1 12 13.2a4.4 4.4 0 0 1-4.4-4L7 3z" /><path d="M7.4 7h9.2M12 13.2V20M8.5 21h7" /></svg>}
{name === 'google' && <svg class={cls} viewBox="0 0 48 48" role="img" aria-label="Google"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z" /><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" /><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z" /><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z" /></svg>}
{name === 'school' && <svg class={cls} {...line}><path d="M2 9l10-5 10 5-10 5z" /><path d="M6 11v5c3 2.5 9 2.5 12 0v-5" /><path d="M22 9v6" /></svg>}
{name === 'clock' && <svg class={cls} {...line}><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>}
{name === 'video' && <svg class={cls} {...line}><rect x="3" y="6" width="13" height="12" rx="2" /><path d="M16 10.5l5-3v9l-5-3" /></svg>}
{name === 'leaf' && <svg class={cls} {...line}><path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15" /><path d="M5 19l7-7" /></svg>}

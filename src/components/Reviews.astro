---
// Google reviews from the live LP's widget, as a masonry of cards. Long reviews clamp to six lines with a
// "Read more" toggle; names and text are verbatim. No link to Google (an Ads LP has no outbound links).
import Icon from './Icon.astro';
interface Props { c: any }
const { REVIEWS: R } = Astro.props.c;
---
<section class="section dark rv" aria-labelledby="rv-title">
  <div class="container">
    <h2 id="rv-title" class="h2">{R.title}</h2>
    <div class="discs" aria-hidden="true"><i></i><i></i><i></i></div>
    <ul class="rv-wall" role="list">
      {R.items.map((r: any, i: number) => (
        <li class="rv-card">
          <div class="rv-top">
            <span class="rv-avatar" aria-hidden="true">{r.name.trim().charAt(0).toUpperCase()}</span>
            <div><p class="rv-name">{r.name}</p><p class="rv-when">{r.when} on Google</p></div>
          </div>
          <p class="rv-stars" role="img" aria-label="5 out of 5 stars">{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</p>
          <p class="rv-text" id={`rv-${i}`} data-clamp={r.text.length > 320 ? '' : undefined}>{r.text}</p>
          {r.text.length > 320 && <button type="button" class="rv-more" aria-expanded="false" aria-controls={`rv-${i}`}>Read more</button>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .rv { background: var(--forest-deep); }
  .rv-wall { list-style: none; margin: 48px 0 0; padding: 0; columns: 1; column-gap: 18px; }
  @media (min-width: 700px) { .rv-wall { columns: 2; } }
  @media (min-width: 1024px) { .rv-wall { columns: 3; } }
  .rv-card { break-inside: avoid; margin-bottom: 18px; padding: 26px; border-radius: var(--radius); background: #fff; color: var(--ink); }
  .rv-top { display: flex; gap: 12px; align-items: center; }
  .rv-avatar { display: grid; place-items: center; width: 44px; height: 44px; flex: none; border-radius: 50%; background: var(--sage); color: var(--forest); font-family: var(--display); font-weight: 800; font-size: 18px; }
  .rv-name { font-weight: 700; color: var(--forest); line-height: 1.3; }
  .rv-when { font-size: 13.5px; color: var(--muted); }
  .rv-stars { display: flex; gap: 2px; margin-top: 14px; color: #c8930e; }
  .rv-stars :global(svg) { width: 18px; height: 18px; }
  .rv-text { margin-top: 10px; font-size: 16px; }
  .rv-text[data-clamp] { display: -webkit-box; -webkit-line-clamp: 6; line-clamp: 6; -webkit-box-orient: vertical; overflow: hidden; }
  .rv-text.open { display: block; }
  .rv-more { margin-top: 10px; padding: 0; border: 0; background: none; color: var(--olive-text); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.rv-more').forEach((b) => b.addEventListener('click', () => {
    const t = document.getElementById(b.getAttribute('aria-controls') || '');
    const open = b.getAttribute('aria-expanded') !== 'true';
    t?.classList.toggle('open', open);
    b.setAttribute('aria-expanded', String(open));
    b.textContent = open ? 'Read less' : 'Read more';
  }));
</script>

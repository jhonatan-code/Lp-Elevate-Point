---
// Google reviews, option D "Google panel" (picked 2026-10-29): a sticky score card like Google's business panel beside
// review cards in Google's style (profile photo, G mark, stars in the yellow of the Google Reviews logo). Reviews come
// from the Google listing, verbatim, picked at similar lengths; every text box has the same height and a longer review
// scrolls inside its card. The panel shows the listing's review count. No link to Google (an Ads LP has no outbound
// links).
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { asset } from '../lib/assets';
import googleReviews from '../assets/brand/google-reviews.svg';
interface Props { c: any }
const { REVIEWS: R } = Astro.props.c;
// Longer than this does not fit the shared text height and gets its own scroll
const SCROLL_AT = 330;
---
<section class="section dark rv" aria-labelledby="rv-title">
  <div class="container">
    <h2 id="rv-title" class="h2">{R.title}</h2>
    <div class="discs" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="rv-grid">
      <div class="rv-panel">
        <img src={googleReviews.src} width="186" height="66" alt="Google Reviews" class="rv-logo" loading="lazy" />
        <p class="rv-score">5.0</p>
        <p class="rv-stars lg" role="img" aria-label="5 out of 5 stars">{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</p>
        <p class="rv-note">Based on {R.count} five-star reviews on Google</p>
        <a href="#benefits-hero" class="btn btn-forest btn-block" data-cta="reviews-verify">Verify Benefits</a>
      </div>
      <ul class="rv-cards" role="list">
        {R.items.map((r: any, i: number) => (
          <li class="rv-card">
            <div class="rv-top">
              <Image src={asset(r.photo)} alt="" width={42} height={42} densities={[1, 2]} class="rv-avatar" loading="lazy" />
              <p class="rv-name">{r.name}</p>
              <Icon name="google" class="rv-g" />
            </div>
            <p class="rv-meta"><span class="rv-stars" role="img" aria-label="5 out of 5 stars">{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</span>{r.when}</p>
            {r.text.length > SCROLL_AT
              ? <p class="rv-text scrolls" tabindex="0" role="region" aria-label={`Review by ${r.name}`}>{r.text}</p>
              : <p class="rv-text">{r.text}</p>}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .rv { background: var(--forest-deep); }
  .rv-grid { display: grid; gap: 24px; margin-top: 44px; }
  @media (min-width: 960px) { .rv-grid { grid-template-columns: 300px minmax(0, 1fr); gap: 28px; align-items: start; }
    .rv-panel { position: sticky; top: calc(var(--header-h) + 24px); } }
  .rv-panel { padding: 30px 26px; border-radius: var(--radius); background: #fff; color: var(--ink); text-align: center; }
  .rv :focus-visible { outline-color: var(--lime); }
  .rv-logo { height: 46px; width: auto; margin-inline: auto; }
  .rv-score { margin-top: 18px; font-family: var(--display); font-weight: 800; font-size: 64px; line-height: 1; letter-spacing: -.03em; color: var(--ink); }
  /* Google's star yellow, the same as the "o" in the Google Reviews logo */
  .rv-stars { display: inline-flex; gap: 2px; color: #f4b400; }
  .rv-stars :global(svg) { width: 17px; height: 17px; }
  .rv-stars.lg { display: flex; justify-content: center; margin-top: 8px; }
  .rv-stars.lg :global(svg) { width: 26px; height: 26px; }
  .rv-note { margin-top: 10px; font-size: 14px; color: var(--muted); }
  .rv-panel .btn { margin-top: 22px; }
  .rv-cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 640px) { .rv-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .rv-card { display: flex; flex-direction: column; padding: 22px; border-radius: 18px; background: #fff; color: var(--ink); }
  .rv-top { display: flex; align-items: center; gap: 12px; }
  .rv-top :global(.rv-avatar) { width: 42px; height: 42px; flex: none; border-radius: 50%; object-fit: cover; background: var(--sage); }
  .rv-name { font-weight: 700; font-size: 15px; line-height: 1.3; color: var(--ink); min-width: 0; }
  .rv-top :global(.rv-g) { width: 22px; height: 22px; flex: none; margin-left: auto; }
  .rv-meta { display: flex; align-items: center; gap: 8px; margin-top: 12px; font-size: 13px; color: var(--muted); }
  /* One text height for every card on desktop (seven lines); a longer review scrolls inside it at any width */
  .rv-text { margin-top: 8px; font-size: 15px; line-height: 1.6; }
  @media (min-width: 960px) { .rv-text { min-height: calc(1.6em * 7); } }
  .rv-text.scrolls { max-height: calc(1.6em * 7); overflow-y: auto; padding-right: 8px; scrollbar-width: thin; scrollbar-color: var(--olive) transparent; overscroll-behavior: contain; }
  .rv-text.scrolls:focus-visible { outline: 2px solid var(--olive-dark); outline-offset: 2px; border-radius: 4px; }
</style>

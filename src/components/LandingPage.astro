---
// The whole LP, fed by one content object (data/content.js). Order follows María's pre-launch review: Why Elevate
// Point after the services, the team after the reviews, the three steps right before the FAQ. Page end is FAQ →
// (mobile-only form) → final CTA → footer (all-projects rule); the CTA and the footer share one photo background
// (Closing.astro).
import Header from './Header.astro';
import Hero from './Hero.astro';
import Programs from './Programs.astro';
import Insurance from './Insurance.astro';
import Services from './Services.astro';
import Why from './Why.astro';
import Band from './Band.astro';
import Treat from './Treat.astro';
import Facility from './Facility.astro';
import Reviews from './Reviews.astro';
import Team from './Team.astro';
import Location from './Location.astro';
import Steps from './Steps.astro';
import Faq from './Faq.astro';
import MobileForm from './MobileForm.astro';
import Closing from './Closing.astro';
import CardActivate from './CardActivate.astro';
interface Props { c: any }
const { c } = Astro.props;
---
<Header />
<main id="main">
  <Hero c={c} />
  <Programs c={c} />
  <Insurance c={c} />
  <Services c={c} />
  <Why c={c} />
  <Band c={c} />
  <Treat c={c} />
  <Facility c={c} />
  <Reviews c={c} />
  <Team c={c} />
  <Location c={c} />
  <Steps c={c} />
  <Faq c={c} />
  <MobileForm />
</main>
<Closing c={c} />
<CardActivate />

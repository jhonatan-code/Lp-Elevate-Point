---
// "We Accept Most Major Insurance Plans": the live LP's text, then the carrier logos as one slow, edge-to-edge row that
// drifts left in a loop. It pauses on hover/focus and with the accessibility menu's "Pause animations"; with reduced
// motion it stands still and scrolls by hand. The list is rendered twice for a seamless loop; the copy is hidden from
// screen readers.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { asset } from '../lib/assets';
interface Props { c: any }
const { INSURANCE: I } = Astro.props.c;
---
<section class="section sage ins" aria-labelledby="ins-title">
  <div class="container center">
    <h2 id="ins-title" class="h2">{I.title}</h2>
    <div class="discs" aria-hidden="true"><i></i><i></i><i></i></div>
    <p class="lead">{I.text}</p>
  </div>
  <div class="marquee">
    <div class="track">
      {[0, 1].map((copy) => (
        <ul class="logos" role="list" aria-label={copy === 0 ? 'Insurance carriers we work with' : undefined} aria-hidden={copy === 1 ? 'true' : undefined}>
          {I.logos.map((l: any) => (
            <li><Image src={asset(l.file)} alt={copy === 0 ? l.alt : ''} width={360} loading="lazy" style={l.w ? `width:${l.w}px;max-height:none` : undefined} /></li>
          ))}
        </ul>
      ))}
    </div>
  </div>
  <div class="container center">
    <div class="cta-row"><a href="#benefits-hero" class="btn btn-olive btn-lg" data-cta="insurance-verify"><Icon name="shield" /> {I.cta}</a></div>
  </div>
</section>

<style>
  /* Edges fade out so logos slide in and out softly */
  .marquee { margin-top: 48px; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .track { display: flex; width: max-content; animation: ins-drift 60s linear infinite; }
  .marquee:hover .track, .marquee:focus-within .track { animation-play-state: paused; }
  @keyframes ins-drift { to { transform: translateX(-50%); } }
  .logos { list-style: none; margin: 0; padding: 0 28px; display: flex; gap: 56px; }
  /* Logos sit straight on the section (no tiles); multiply drops the white of each file into the sage */
  .logos li { display: grid; place-items: center; min-width: 170px; height: 72px; flex: none; }
  .logos :global(img) { max-height: 52px; width: auto; object-fit: contain; mix-blend-mode: multiply; }
  @media (max-width: 640px) { .logos { gap: 40px; padding: 0 20px; } .logos li { min-width: 130px; height: 60px; } .logos :global(img) { max-height: 44px; } }
  /* Still for reduced motion and for "Pause animations": one row the visitor can scroll */
  @media (prefers-reduced-motion: reduce) {
    .marquee { overflow-x: auto; mask-image: none; }
    .track { animation: none; }
    .logos[aria-hidden] { display: none; }
  }
  :global(html.a11y-motion) .track { animation-play-state: paused; }
</style>

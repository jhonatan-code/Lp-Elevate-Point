---
// "We Accept Most Major Insurance Plans": the live LP's text and carrier logos on white tiles.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { asset } from '../lib/assets';
interface Props { c: any }
const { INSURANCE: I } = Astro.props.c;
---
<section class="section sage" aria-labelledby="ins-title">
  <div class="container center">
    <h2 id="ins-title" class="h2">{I.title}</h2>
    <div class="discs" aria-hidden="true"><i></i><i></i><i></i></div>
    <p class="lead">{I.text}</p>
    <ul class="logos" role="list">
      {I.logos.map((l: any) => (
        <li><Image src={asset(l.file)} alt={l.alt} width={180} loading="lazy" /></li>
      ))}
    </ul>
    <div class="cta-row"><a href="#benefits-hero" class="btn btn-olive btn-lg" data-cta="insurance-verify"><Icon name="shield" /> {I.cta}</a></div>
  </div>
</section>

<style>
  .logos { list-style: none; margin: 48px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (min-width: 640px) { .logos { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .logos { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 14px; } }
  .logos li { display: grid; place-items: center; height: 88px; padding: 12px 16px; border-radius: 999px; background: #fff; box-shadow: var(--shadow-card); }
  .logos :global(img) { max-height: 52px; width: auto; object-fit: contain; mix-blend-mode: multiply; }
</style>

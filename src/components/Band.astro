---
// "There's a Light on the Other Side of Addiction": a photo band with the call and verify buttons (the live LP puts its
// first form here; on this page the hero form serves it).
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { asset } from '../lib/assets';
import { PHONE } from '../data/site.js';
interface Props { c: any }
const { BAND: B } = Astro.props.c;
---
<section class="band dark" aria-labelledby="band-title">
  <Image src={asset(B.photo)} alt="" class="band-bg" widths={[640, 1280, 1920]} sizes="100vw" loading="lazy" />
  <div class="container band-in">
    <h2 id="band-title" class="h2">{B.title}</h2>
    <p class="lead">{B.text}</p>
    <div class="cta-row">
      <a href={PHONE.href} class="btn btn-lime btn-lg" data-cta="band-call"><Icon name="phone" /> Call {PHONE.display}</a>
      <a href="#benefits-hero" class="btn btn-ghost btn-lg" data-cta="band-verify">Verify Benefits</a>
    </div>
  </div>
</section>

<style>
  .band { position: relative; isolation: isolate; overflow: hidden; padding-block: 88px; }
  @media (min-width: 1024px) { .band { padding-block: 128px; } }
  .band-bg { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .band::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(20 53 48 / .94), rgb(31 73 65 / .72) 60%, rgb(31 73 65 / .35)); }
  .band-in { max-width: 1200px; }
  .band h2 { max-width: 760px; }
</style>

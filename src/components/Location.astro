---
// Map section before the FAQ, option B "Station rail" (picked 2026-10-29): centered heading, one card per nearby
// subway station plus parking, then a wide Google Map with the address chip on it. The map is a third-party embed, so
// it loads only with Functional cookie consent (CookieConsent swaps data-consent-src for src); until then a
// placeholder over a terrace photo offers to load it.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { asset } from '../lib/assets';
import { ORG, PHONE } from '../data/site.js';
interface Props { c: any }
const { LOCATION: L } = Astro.props.c;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(`Elevate Point, ${ORG.address}`)}&z=16&output=embed`;
---
<section class="section sage" aria-labelledby="loc-title">
  <div class="container">
    <div class="center">
      <h2 id="loc-title" class="h2">{L.title}</h2>
      <div class="discs" aria-hidden="true"><i></i><i></i><i></i></div>
      <p class="lead">{L.text}</p>
    </div>
    <ul class="rail" role="list">
      {L.stations.map((s: any) => (
        <li class="lift stop">
          <span class="lines" aria-hidden="true">{s.lines.map((l: string) => <i>{l}</i>)}</span>
          <b>{s.name}</b>
          <small>{s.lines.join(', ')} trains</small>
        </li>
      ))}
      <li class="lift stop">
        <span class="lines" aria-hidden="true"><i class="park">P</i></span>
        <b>{L.parking}</b>
        <small>For clients and visitors</small>
      </li>
    </ul>
    <div class="map">
      <iframe data-consent-src={mapSrc} title={`Map of ${ORG.name} at ${ORG.address}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      <div class="map-ph" data-consent-placeholder>
        <Image src={asset('outdoor-terrace.webp')} alt="" widths={[640, 1100, 1600]} sizes="(min-width: 1280px) 1200px, 92vw" loading="lazy" />
        <div class="map-ph-box">
          <p>The map comes from Google Maps, which may set its own cookies.</p>
          <button type="button" class="btn btn-forest" data-consent-load><Icon name="pin" /> Show the map</button>
        </div>
      </div>
      <address class="chip">
        <span class="chip-pin" aria-hidden="true"><Icon name="pin" /></span>
        <span class="chip-text"><strong>{ORG.street}</strong>{ORG.city}</span>
        <a href={PHONE.href} class="btn btn-forest" data-cta="location-call"><Icon name="phone" /> Call</a>
      </address>
    </div>
  </div>
</section>

<style>
  .rail { list-style: none; margin: 44px 0 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) { .rail { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; } }
  .stop { display: grid; gap: 10px; align-content: start; justify-items: start; padding: 20px; border-radius: var(--radius); background: #fff; box-shadow: var(--shadow-card); }
  .stop b { font-family: var(--display); font-size: 17px; line-height: 1.2; color: var(--forest); }
  .stop small { margin-top: -6px; font-size: 13.5px; color: var(--muted); }
  @media (max-width: 899px) { .stop:last-child { grid-column: 1 / -1; } }
  /* Subway bullets: the round line symbols of the NYC subway, in forest green (one color, on brand) */
  .lines { display: flex; gap: 4px; }
  .lines i { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; font-style: normal; font-weight: 700; font-size: 13px; color: #fff; background: var(--forest); }
  .lines i.park { border-radius: 7px; }
  .map { position: relative; margin-top: 18px; height: 440px; border-radius: var(--radius-lg); overflow: hidden; background: var(--forest-deep); }
  @media (max-width: 640px) { .map { height: 480px; } }
  .map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .map-ph { position: absolute; inset: 0; display: grid; place-items: center; }
  .map-ph :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .map-ph::after { content: ''; position: absolute; inset: 0; background: rgb(14 38 34 / .55); }
  .map-ph-box { position: relative; z-index: 1; display: grid; gap: 14px; justify-items: center; max-width: 360px; padding: 24px; text-align: center; }
  .map-ph-box p { font-size: 15px; color: #fff; }
  .map-ph-box .btn { background: #fff; color: var(--forest); }
  .map-ph-box .btn:hover { background: var(--lime); }
  /* Address chip over the map, bottom left */
  .chip { position: absolute; z-index: 2; left: 16px; right: 16px; bottom: 16px; display: flex; align-items: center; gap: 14px; padding: 12px 12px 12px 14px;
    border-radius: 20px; background: #fff; box-shadow: 0 12px 32px rgb(14 38 34 / .25); font-style: normal; }
  @media (min-width: 640px) { .chip { right: auto; left: 22px; bottom: 22px; } }
  .chip-pin { display: grid; place-items: center; width: 44px; height: 44px; flex: none; border-radius: 50%; background: var(--lime); color: var(--forest-ink); }
  .chip-pin :global(svg) { width: 22px; height: 22px; }
  .chip-text { display: flex; flex-direction: column; line-height: 1.3; font-size: 14.5px; color: var(--muted); min-width: 0; }
  .chip-text strong { font-family: var(--display); font-size: 18px; color: var(--forest); }
  .chip .btn { margin-left: auto; }
</style>

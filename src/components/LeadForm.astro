---
// Native lead form (white card with a forest head band, lime button, HIPAA mark). Both instances (hero and the
// mobile-only form before the final CTA) post to /api/lead, which adds CTM auth and forwards to FormReactor.
//
// ⚠️ FIELD NAMES ARE NOT COSMETIC. They match the allowlist in api/lead.js and the CTM reactor for this LP
// (FRT472ABB2C5…80B2, account 552861, given 2026-10-29): name, phone (the only required one), email,
// membership_policy_id, insurance_carrier and sms_consent. CTM silently drops names it does not recognize and still
// answers success. The live LP's "Covered by Insurance?" / "Paying With:" choices are not reactor fields, so they are
// not asked here.
//
// Submission: progressive enhancement. With JS, the script posts with fetch (double submit guard + 12s timeout)
// and redirects to /thank-you/?sent=1 only when CTM accepted the lead; that page pushes {event:'lead_accepted'}.
// Without JS, the browser posts and api/lead.js answers with a 303.
import { CARRIERS } from '../data/site.js';
import { FORM } from '../data/content.js';
import hipaa from '../assets/brand/hipaa-white.svg';

interface Props {
  formId: 'hero' | 'full';
  heading?: string;
}
const { formId } = Astro.props;
const heading = Astro.props.heading ?? FORM.heading;
const formTag = formId;
const id = (n: string) => `${formId}-${n}`;
---

<div class="lead-card" id={formId === 'full' ? 'benefits' : 'benefits-hero'} data-hide-callbar>
  <div class="lf-head">
    <h2 class="lf-title">{heading}</h2>
    <img src={hipaa.src} width="88" height="44" alt="HIPAA compliant" class="lf-hipaa" loading="lazy" />
  </div>

  <form method="POST" action="/api/lead" class="lf" data-lead-form novalidate>
    <input type="hidden" name="paid_attribution[form_id]" value={formTag} />
    <input type="hidden" name="paid_attribution[gclid]" value="" data-click="gclid" />
    <input type="hidden" name="paid_attribution[gbraid]" value="" data-click="gbraid" />
    <input type="hidden" name="paid_attribution[wbraid]" value="" data-click="wbraid" />
    <input type="hidden" name="paid_attribution[campaign_id]" value="" data-click="campaignid" />
    <input type="hidden" name="paid_attribution[adgroup_id]" value="" data-click="adgroupid" />
    <input type="hidden" name="paid_attribution[creative_id]" value="" data-click="creative" />
    <input type="hidden" name="paid_attribution[source]" value="" data-click="utm_source" />
    <input type="hidden" name="paid_attribution[medium]" value="" data-click="utm_medium" />
    <input type="hidden" name="paid_attribution[campaign]" value="" data-click="utm_campaign" />
    <input type="hidden" name="visitor_sid" value="" data-visitor-sid />
    <input type="hidden" name="rendered_at" value="" data-rendered-at />

    <div class="lf-grid">
      <div class="lf-field">
        <label for={id('name')}>Name <span class="req" aria-hidden="true">*</span></label>
        <input id={id('name')} name="caller_name" type="text" required autocomplete="name" maxlength="80" />
      </div>
      <div class="lf-field">
        <label for={id('phone')}>Phone <span class="req" aria-hidden="true">*</span></label>
        <input id={id('phone')} name="phone_number" type="tel" required autocomplete="tel" inputmode="tel" maxlength="24" />
      </div>
      <div class="lf-field lf-wide">
        <label for={id('email')}>Email Address</label>
        <input id={id('email')} name="email" type="email" autocomplete="email" maxlength="140" />
      </div>
      <div class="lf-field">
        <label for={id('carrier')}>Insurance Carrier</label>
        <select id={id('carrier')} name="custom_fields[insurance_carrier]">
          <option value="" selected>Choose one</option>
          {CARRIERS.map((c) => <option value={c}>{c}</option>)}
        </select>
      </div>
      <div class="lf-field">
        <label for={id('member')}>Member / Policy ID</label>
        <input id={id('member')} name="custom_fields[membership_policy_id]" type="text" autocomplete="off" maxlength="40" />
      </div>
    </div>

    <div class="lf-sms">
      <input id={id('sms')} name="custom_fields[sms_consent]" type="checkbox" value="Yes" />
      <label for={id('sms')}><strong>SMS Opt-In:</strong> {FORM.sms}</label>
    </div>

    {/* Honeypot. Off screen rather than display:none, which some bots skip. */}
    <div aria-hidden="true" class="hp">
      <label for={id('company')}>Company website</label>
      <input id={id('company')} name="company_website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <p class="lf-error" role="alert" data-error hidden></p>

    <button type="submit" class="btn btn-lime btn-block" data-cta={`form-${formId}-submit`}>Submit</button>

    <p class="lf-note">{FORM.note}</p>
    <p class="lf-consent">By submitting, you agree that Elevate Point admissions may contact you by phone about treatment.</p>
  </form>
</div>

<style>
  /* Hero/banner forms are capped at 500px (all-projects rule) */
  .lead-card { position: relative; width: 100%; max-width: 500px; background: #fff; color: var(--ink); border-radius: var(--radius-lg); overflow: hidden;
    box-shadow: 0 30px 70px rgb(14 38 34 / .32); scroll-margin-top: calc(var(--header-h) + 16px); }
  .lf-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 20px 22px; background: var(--forest); }
  @media (min-width: 768px) { .lf-head { padding: 22px 32px; } }
  .lf-title { font-family: var(--display); font-size: clamp(20px, 2vw, 24px); font-weight: 700; color: #fff; line-height: 1.15; }
  .lf-hipaa { height: 38px; width: auto; flex: none; opacity: .9; }
  .lf { padding: 20px 22px 22px; }
  @media (min-width: 768px) { .lf { padding: 26px 32px 28px; } }
  .lf-grid { display: grid; gap: 14px; }
  @media (min-width: 480px) { .lf-grid { grid-template-columns: 1fr 1fr; } .lf-wide { grid-column: 1 / -1; } }
  .lf-field label { display: block; font-size: 14px; font-weight: 700; margin-bottom: 6px; color: var(--forest); }
  .req { color: #b42318; }
  .lf-field input, .lf-field select { width: 100%; font: inherit; font-size: 16px; color: var(--ink); padding: 10px 14px; height: 50px;
    border: 1.5px solid #b8c2ad; border-radius: 12px; background: var(--mist); transition: border-color .2s, box-shadow .2s; }
  .lf-field select { padding-right: 28px; font-size: 15px; }
  .lf-field input:focus, .lf-field select:focus { outline: none; border-color: var(--forest); box-shadow: 0 0 0 3px rgb(31 73 65 / .25); }
  .lf-field input[aria-invalid='true'] { border-color: #b42318; box-shadow: 0 0 0 2px rgb(180 35 24 / .3); }
  .lf-sms { display: flex; gap: 10px; align-items: flex-start; margin-top: 16px; }
  .lf-sms input { width: 20px; height: 20px; flex: none; margin: 2px 0 0; accent-color: var(--forest); }
  .lf-sms label { font-size: 12px; line-height: 1.45; color: var(--muted); }
  .lf-sms strong { color: var(--forest); }
  .lf-field input::placeholder { color: #6b7280; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .lf button { margin-top: 20px; }
  .lf .btn-lime { background: var(--forest); color: #fff; }
  .lf .btn-lime:hover { background: var(--forest-deep); }
  .lf button[aria-disabled='true'] { opacity: .75; cursor: progress; }
  .lf-error { margin: 12px 0 0; padding: 10px 12px; border-radius: 8px; background: #fdecea; color: #8a1c13; font-size: 14px; }
  .lf-error :global(a) { color: #8a1c13; font-weight: 700; }
  .lf-note { margin: 14px 0 0; text-align: center; font-size: 14px; font-weight: 700; color: var(--forest); }
  .lf-consent { margin: 6px 0 0; text-align: center; font-size: 12.5px; color: var(--muted); }
</style>

<script>
  import { phoneFor } from '../data/site.js';
  const PHONE = phoneFor(location.pathname);
  const SUBMIT_LABEL = 'Submit';
  const TIMEOUT_MS = 12000;

  // Render time from the client. A build time value would be identical for
  // every visitor and silently disable the minimum fill time spam check.
  document.querySelectorAll<HTMLInputElement>('[data-rendered-at]').forEach((el) => (el.value = String(Date.now())));

  // Google click ids and ValueTrack/UTM values, kept in sessionStorage for the
  // visit because the visitor may land with ?gclid= and submit after the URL
  // has changed (an anchor, a reload, back from the thank-you page).
  const KEYS = ['gclid', 'gbraid', 'wbraid', 'campaignid', 'adgroupid', 'creative', 'utm_source', 'utm_medium', 'utm_campaign'];
  const params = new URLSearchParams(location.search);
  const vals: Record<string, string> = {};
  for (const k of KEYS) {
    let v = params.get(k) || '';
    try {
      if (v) sessionStorage.setItem(`elevatepoint_${k}`, v);
      else v = sessionStorage.getItem(`elevatepoint_${k}`) || '';
    } catch {
      /* storage blocked: the URL value still works */
    }
    vals[k] = v.slice(0, 200);
  }
  document.querySelectorAll<HTMLInputElement>('[data-click]').forEach((el) => (el.value = vals[el.dataset.click || ''] || ''));

  // CTM session id, read at SUBMIT: the tracker arrives through GTM after the
  // first interaction, so it is rarely ready at render. window.__ctm first,
  // the __ctmid cookie as fallback, and only a plain token is sent.
  function ctmSid(): string {
    const w = window as unknown as { __ctm?: { config?: { sid?: string } } };
    let sid = w.__ctm?.config?.sid || '';
    if (!sid) {
      const m = document.cookie.match(/(?:^|;\s*)__ctmid=([^;]+)/);
      sid = m ? decodeURIComponent(m[1]) : '';
    }
    return /^[A-Za-z0-9_-]{6,128}$/.test(sid) ? sid : '';
  }

  function phoneOk(v: string) {
    const d = v.replace(/\D/g, '');
    return d.length === 10 || (d.length === 11 && d.startsWith('1')) || (v.trim().startsWith('+') && d.length >= 8 && d.length <= 15);
  }

  function reset(form: HTMLFormElement) {
    delete form.dataset.sending;
    const b = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (b) { b.removeAttribute('aria-disabled'); b.textContent = SUBMIT_LABEL; }
  }

  function showError(form: HTMLFormElement, msg: string) {
    const box = form.querySelector<HTMLElement>('[data-error]');
    if (!box) return;
    box.innerHTML = `${msg} Please call <a href="${PHONE.href}">${PHONE.display}</a> and admissions will help right away.`;
    box.hidden = false;
  }

  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      // One lead per click. A double tap on a slow connection would post the
      // same person twice and admissions would call them twice.
      if (form.dataset.sending === '1') return;

      const name = form.elements.namedItem('caller_name') as HTMLInputElement;
      const phone = form.elements.namedItem('phone_number') as HTMLInputElement;
      const errBox = form.querySelector<HTMLElement>('[data-error]');
      if (errBox) errBox.hidden = true;
      name.setAttribute('aria-invalid', String(!name.value.trim()));
      phone.setAttribute('aria-invalid', String(!phoneOk(phone.value)));
      if (!name.value.trim()) { name.focus(); return; }
      if (!phoneOk(phone.value)) {
        phone.focus();
        if (errBox) { errBox.textContent = 'Please enter a 10 digit phone number so admissions can call you back.'; errBox.hidden = false; }
        return;
      }

      form.dataset.sending = '1';
      const sidInput = form.querySelector<HTMLInputElement>('[data-visitor-sid]');
      if (sidInput) sidInput.value = ctmSid();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) { button.setAttribute('aria-disabled', 'true'); button.textContent = 'Sending...'; }

      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), TIMEOUT_MS);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString(),
          signal: ctrl.signal,
        });
        clearTimeout(timer);
        const data = await res.json().catch(() => null);
        if (data && typeof data.redirect === 'string' && data.redirect.startsWith('/thank-you/')) {
          location.assign(data.redirect);
          return;
        }
        reset(form);
        showError(form, 'Something went wrong sending your details.');
      } catch {
        clearTimeout(timer);
        // Timeout or network failure. Do NOT resubmit automatically: CTM may
        // have received the first post. Hand the visitor the phone number.
        reset(form);
        showError(form, 'This is taking longer than it should.');
      }
    });
  });

  // Back button after the redirect restores the page from bfcache with the
  // guard still set. Clear it so the form works again.
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach(reset);
  });
</script>
